{
  "name": "inmo-api-sdk",
  "version": "0.0.1",
  "description": "Internal API SDK package for Inmo Web",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=27"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "openapi-ts && tsx scripts/generate-root-client.ts && tsx scripts/generate-api-repos.ts",
    "build": "tsup",
    "smoke": "tsx scripts/smoke-test.ts",
    "sync-schema": "node --experimental-strip-types scripts/sync-schema.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hey-api/client-axios": "^0.9.1",
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.66.5",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
